# Copy to .env for local use. On Replit, set these as Secrets instead.

# PostgreSQL connection string for THIS app's own database (never Clarity's or
# another app's — setup refuses one) — or, for laptop mode (docs/laptop.md), a
# local database folder: DATABASE_URL=pglite:./data
DATABASE_URL=

# Karbon API (read-only use). Same credentials type as Clarity.
KARBON_API_KEY=
KARBON_API_SECRET=
# The internal HFA client, by its Karbon client ID. Resolved to Karbon's key
# at run time; `pnpm tg karbon:check` shows what it resolved to.
KARBON_INTERNAL_CLIENT_IDS=99999
# Optional: internal client(s) by Karbon key directly (comma-separated).
KARBON_INTERNAL_CLIENT_KEYS=
# Title of the Ad Hoc work item every client has.
KARBON_AD_HOC_TITLE=Ad Hoc
# "Open timesheet" links: a timesheet's address from Karbon's address bar, with
# the timesheet key replaced by {key}. Blank = no links. Confirm with karbon:check.
# KARBON_TIMESHEET_URL=https://app2.karbonhq.com/<tenant key>/timesheet/{key}
KARBON_TIMESHEET_URL=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=HFA Time Governance
TG_REPLY_TO=

# off | shadow | live. Start in shadow: every email goes to TG_SHADOW_TO only.
TG_MODE=shadow
TG_SHADOW_TO=
# Run summaries (comma-separated).
TG_ADMIN_TO=

# Karbon governance notes (optional): off | shadow | live. Notes only ever go
# to Hidden clients of the governance type (checked every run).
TG_KARBON_NOTES=off
# The Karbon user the notes are posted as.
KARBON_NOTE_AUTHOR=
KARBON_GOVERNANCE_CLIENT_TYPE=Governance
# Shadow mode: the governance client (by client ID) that receives every note.
KARBON_NOTES_SHADOW_CLIENT_ID=

FIRM_TIMEZONE=America/New_York

# Thresholds (approved defaults).
MINIMAL_WEEK_HOURS=20
FULL_TIME_WEEK_HOURS=40
AD_HOC_WEEKLY_HOURS=4
AD_HOC_RECURRING_WEEKS=3
# A week counts toward the streak only with at least this many ad hoc hours.
AD_HOC_RECURRING_MIN_HOURS=1
NONBILLABLE_MIN_DESCRIPTION_CHARS=10
INTERNAL_ONLY_ROLE_MARKER=(Internal Only)
ESCALATION_LOOKBACK_WEEKS=4
# A month-over-month utilization drop this large is called out even at target.
UTILIZATION_DROP_POINTS=10
# History is kept ~7 years (0 = forever). Emails only look back 4 weeks and this year.
HISTORY_RETENTION_DAYS=2557
